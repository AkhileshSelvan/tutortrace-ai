# Optional; set in your shell. This file is documentation, not automatically loaded.
TUTORTRACE_DATA_DIR=data
# Local inference: installed models only; the app never downloads models.
TUTORTRACE_LLM_PROVIDER=ollama
TUTORTRACE_LLM_MODEL=qwen3:4b
TUTORTRACE_LLM_URL=http://127.0.0.1:11434
TUTORTRACE_TIMEOUT=120
TUTORTRACE_CONTEXT_TOKENS=4096
TUTORTRACE_OUTPUT_TOKENS=900
TUTORTRACE_EMBED_MODEL=nomic-embed-text:latest
TUTORTRACE_EMBED_URL=http://127.0.0.1:11434
# Remote alternative: OpenAI-compatible /chat/completions with JSON-object support.
# TUTORTRACE_LLM_PROVIDER=openai-compatible
# TUTORTRACE_LLM_MODEL=<your-provider-model>
# TUTORTRACE_LLM_URL=https://your-provider.example/v1
# Supply TUTORTRACE_API_KEY through your shell or secret manager, never commit it.
